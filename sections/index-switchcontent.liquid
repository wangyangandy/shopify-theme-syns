{{ 'section-index-switchcontent.css' | asset_url | stylesheet_tag }}

<div class="index-switchcontent index-switchcontent-{{ section.id }}" style="margin-top: {{ section.settings.top_dis }}px; margin-bottom: {{ section.settings.bottom_dis }}px;">
  <div class="section-wrap page-width">
    {% if section.settings.lefttitle != blank %}
      <h3 class="switchcontent-lefttitle">{{ section.settings.lefttitle }}</h3>
    {% endif %}
    
    <div class="switchcontent-container switchcontent-container-{{ section.id }} swiper-container">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="switchcontent-item swiper-slide">
            {% if block.settings.icon != blank %}
              <div class="switchcontent-icon">
                <img src="{{ block.settings.icon }}" alt="{{ block.settings.title }}">
              </div>
            {% endif %}
            
            {% if block.settings.title != blank %}
              <h4 class="switchcontent-title">{{ block.settings.title }}</h4>
            {% endif %}
            
            {% if block.settings.leftcon != blank %}
              <div class="switchcontent-content rte">
                {{ block.settings.leftcon }}
              </div>
            {% endif %}
            
            <div class="switchcontent-image">
              <img 
                src="{{ block.settings.image }}" 
                srcset="{{ block.settings.image }} 1x, {{ block.settings.imagemb }} 2x" 
                alt="{{ block.settings.title }}"
                class="switchcontent-image-desktop"
              >
              <img 
                src="{{ block.settings.imagemb }}" 
                alt="{{ block.settings.title }}"
                class="switchcontent-image-mobile"
              >
            </div>
          </div>
        {% endfor %}
      </div>
      
      <!-- 分页指示器 -->
      <div class="swiper-pagination switchcontent-pagination switchcontent-pagination-{{ section.id }}"></div>
      
      <!-- 导航箭头 -->
      <div class="swiper-button-prev switchcontent-prev switchcontent-prev-{{ section.id }}"></div>
      <div class="swiper-button-next switchcontent-next switchcontent-next-{{ section.id }}"></div>
    </div>
  </div>
</div>

<script defer>
  document.addEventListener('DOMContentLoaded', () => {
    var switchcontentSwiper = null;

    function initSwiper() {
      // 检查是否已初始化，如果已初始化则销毁
      if (switchcontentSwiper) {
        switchcontentSwiper.destroy(true, true);
        switchcontentSwiper = null;
      }

      // 重新初始化Swiper
      switchcontentSwiper = new Swiper('.switchcontent-container-{{ section.id }}', {
        slidesPerView: 3, // 一行显示3个
        spaceBetween: 24, // 间距
        centeredSlides: false,
        grabCursor: true,
        loop: false, // 不循环
        observer: true,
        resizeObserver: true,
        
        // 分页设置
        pagination: {
          el: '.switchcontent-pagination-{{ section.id }}',
          clickable: true,
        },
        
        // 导航箭头设置
        navigation: {
          nextEl: '.switchcontent-next-{{ section.id }}',
          prevEl: '.switchcontent-prev-{{ section.id }}',
        },
        
        // 响应式设置
        breakpoints: {
          0: {
            slidesPerView: 1, // 移动端一行1个
            spaceBetween: 16,
          },
          768: {
            slidesPerView: 2, // 平板一行2个
            spaceBetween: 20,
          },
          1024: {
            slidesPerView: 3, // 桌面端一行3个
            spaceBetween: 24,
          },
        },
        
        // 启用触摸滑动
        touchEventsTarget: 'container',
        simulateTouch: true,
        touchRatio: 1,
        touchAngle: 45,
      });
    }

    // 初始化Swiper
    initSwiper();

    // 窗口调整大小时重新初始化Swiper
    $(window).on('resize', function() {
      initSwiper();
    });
  });
</script>

{% schema %}
{
  "name": "Index Switch Content",
  "tag": "section",
  "class": "section-index-switchcontent",
  "settings": [
    {
      "type": "number",
      "id": "top_dis",
      "label": "Top Margin",
      "default": 0,
      "min": 0,
      "max": 200,
      "unit": "px"
    },
    {
      "type": "number",
      "id": "bottom_dis",
      "label": "Bottom Margin",
      "default": 100,
      "min": 0,
      "max": 200,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "lefttitle",
      "label": "Left Title",
      "default": "As seen on"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "imagemb",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    }
  ],
  "blocks": [
    {
      "name": "Content Block",
      "type": "block",
      "settings": [
        {
          "type": "richtext",
          "id": "leftcon",
          "label": "Content"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "imagemb",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Block Title"
        }
      ]
    }
  ],
  "block_order": true,
  "presets": [
    {
      "name": "Index Switch Content",
      "blocks": [
        {
          "type": "block"
        },
        {
          "type": "block"
        },
        {
          "type": "block"
        }
      ]
    }
  ]
}
{% endschema %}